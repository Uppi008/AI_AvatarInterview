# =============================================
# AI_AvatarInterview — Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit the real .env file.
# =============================================

# --- Django Core ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Only relevant with config.settings.prod. Leave False until nginx's :443
# server block (docker/nginx/nginx.prod.conf) has real certs and is live --
# turning this on first causes a redirect loop (see docs/DEPLOYMENT.md #4).
DJANGO_SECURE_SSL_REDIRECT=False

# --- Database (PostgreSQL) ---
POSTGRES_DB=ai_avatarinterview
POSTGRES_USER=ai_avatar_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://ai_avatar_user:change-me@db:5432/ai_avatarinterview

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=change-me-separately-from-secret-key

# --- CORS / CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Email (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=app-specific-password
DEFAULT_FROM_EMAIL=AI_AvatarInterview <no-reply@aiavatarinterview.com>

# --- Google OAuth (optional login) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- LLM Provider: Groq (primary) ---
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# --- LLM Fallback providers (optional, same interface via LangChain) ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Speech ---
WHISPER_MODEL_SIZE=base
TTS_PROVIDER=edge-tts

# --- AWS S3 / Object storage (optional, for prod media) ---
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws
VITE_DEFAULT_LANGUAGE=en

# --- Sentry / Monitoring (optional) ---
SENTRY_DSN=
